---
import { SITE_AUTHOR } from "../../consts";
import { type Publication } from "../../data/research";
import GitHubStars from "./GitHubStars.astro";

interface Props {
  papers: readonly Publication[];
}

const { papers } = Astro.props;
---

<ul class="publication-list m-0 list-none p-0">
  {
    papers.map((paper) => (
      <li
        class="publication py-6 border-b border-black/15 dark:border-white/15"
        id={`paper-${paper.id}`}
      >
        <img
          src={paper.cover}
          alt={`Overview of ${paper.title}`}
          width="160"
          height="112"
          loading="lazy"
          decoding="async"
          class="publication-cover hidden sm:block"
        />
        <div class="min-w-0">
          <h3 class="m-0 text-lg leading-snug font-semibold">
            <a
              href={
                paper.links.find((link) => link.label === "Paper")?.url ??
                paper.links.find((link) => link.label === "Code")?.url ??
                paper.links[0]?.url
              }
            >
              {paper.title}
            </a>
          </h3>
          {paper.authors.length > 0 && (
            <p class="mt-2 text-sm leading-relaxed opacity-80">
              {paper.authors.map((author, index) => (
                <>
                  {index > 0 && ", "}
                  {author.replace(/[*#]+$/, "") === SITE_AUTHOR ? (
                    <strong>{author}</strong>
                  ) : (
                    author
                  )}
                </>
              ))}
            </p>
          )}
          {paper.description && (
            <p class="mt-2 text-sm leading-relaxed opacity-80">
              {paper.description}
            </p>
          )}
          <p class="mt-2 text-sm">
            <span class="italic">{paper.venue}</span> {paper.year}
            {paper.distinction && (
              <span class="ml-2 font-semibold">{paper.distinction}</span>
            )}
          </p>
          {(paper.authors.some((author) => author.includes("*")) ||
            paper.authors.some((author) => author.includes("#"))) && (
            <p class="mt-1 text-xs opacity-65">
              {paper.authors.some((author) => author.includes("*")) &&
                "* equal contribution"}
              {paper.authors.some((author) => author.includes("*")) &&
                paper.authors.some((author) => author.includes("#")) &&
                "; "}
              {paper.authors.some((author) => author.includes("#")) &&
                "# corresponding author"}
            </p>
          )}
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-3 font-overpass-mono text-xs">
            {paper.links.map((link) => (
              <a href={link.url} aria-label={`${link.label}: ${paper.title}`}>
                {link.label}
              </a>
            ))}
            {paper.github && <GitHubStars {...paper.github} />}
          </div>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .publication:last-child {
    border-bottom: 0;
  }
  .publication-cover {
    width: 160px;
    height: 112px;
    object-fit: contain;
    background: white;
    border-radius: 2px;
  }
  @media (min-width: 800px) {
    .publication {
      display: grid;
      grid-template-columns: 160px minmax(0, 1fr);
      gap: 1.75rem;
      align-items: start;
    }
  }
</style>
