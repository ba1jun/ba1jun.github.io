---
interface Props {
  repository: string;
  stars: number;
  checkedAt: string;
}

const { repository, stars, checkedAt } = Astro.props;
const count = stars.toLocaleString("en-US");
---

<a
  href={`https://github.com/${repository}/stargazers`}
  class="inline-flex items-center gap-1.5 whitespace-nowrap"
  data-github-stars={repository}
  aria-label={`GitHub stars: ${count}`}
  title={`GitHub stars · checked ${checkedAt}`}
  data-pagefind-ignore
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="13"
    height="13"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linejoin="round"
    aria-hidden="true"
    class="shrink-0"
  >
    <path
      d="m12 3 2.78 5.63L21 9.54l-4.5 4.39 1.06 6.2L12 17.2l-5.56 2.93 1.06-6.2L3 9.54l6.22-.91L12 3Z"
    ></path>
  </svg>
  <span data-star-count>{count}</span>
  <span>stars</span>
</a>

<script>
  interface StarCount {
    stars: number;
    checkedAt: number;
  }

  const cache = new Map<
    string,
    { request: Promise<StarCount | null>; expiresAt: number }
  >();
  const cacheLifetime = 60 * 60 * 1000;

  function getStars(repository: string): Promise<StarCount | null> {
    const pending = cache.get(repository);
    if (pending && pending.expiresAt > Date.now()) return pending.request;

    const request = (async () => {
      const key = `github-stars:${repository}`;
      try {
        const stored: StarCount | null = JSON.parse(
          sessionStorage.getItem(key) ?? "null",
        );
        if (
          stored &&
          Number.isSafeInteger(stored.stars) &&
          stored.stars >= 0 &&
          Number.isFinite(stored.checkedAt) &&
          stored.checkedAt <= Date.now() &&
          Date.now() - stored.checkedAt < cacheLifetime
        )
          return stored;
      } catch {
        // Storage can be unavailable; the rendered count remains usable.
      }

      try {
        const response = await fetch(
          `https://api.github.com/repos/${repository}`,
          {
            headers: { Accept: "application/vnd.github+json" },
            signal: AbortSignal.timeout(8000),
          },
        );
        if (!response.ok) return null;
        const data: { stargazers_count?: unknown } = await response.json();
        if (
          typeof data.stargazers_count !== "number" ||
          !Number.isSafeInteger(data.stargazers_count) ||
          data.stargazers_count < 0
        )
          return null;
        const result = { stars: data.stargazers_count, checkedAt: Date.now() };
        try {
          sessionStorage.setItem(key, JSON.stringify(result));
        } catch {
          // The in-memory cache still avoids duplicate requests during navigation.
        }
        return result;
      } catch {
        return null;
      }
    })();
    cache.set(repository, { request, expiresAt: Date.now() + cacheLifetime });
    return request;
  }

  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLAnchorElement>("[data-github-stars]")
      .forEach(async (link) => {
        const repository = link.dataset.githubStars;
        const count = link.querySelector("[data-star-count]");
        if (!repository || !count) return;
        const result = await getStars(repository);
        if (!result || !link.isConnected) return;
        const formatted = result.stars.toLocaleString("en-US");
        count.textContent = formatted;
        link.setAttribute("aria-label", `GitHub stars: ${formatted}`);
        link.title = `GitHub stars · checked ${new Date(result.checkedAt).toISOString().slice(0, 10)}`;
      });
  });
</script>
