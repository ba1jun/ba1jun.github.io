---
const today = new Date();
import { Icon } from "astro-icon/components";
import { SHOW_SOCIAL_LINKS, SITE_AUTHOR, SOCIAL_LINKS } from "../consts";

const socialItems = [
  {
    href: SOCIAL_LINKS.github,
    label: `Visit ${SITE_AUTHOR}'s GitHub profile`,
    icon: "mdi:github",
  },
  {
    href: SOCIAL_LINKS.linkedin,
    label: `Visit ${SITE_AUTHOR}'s LinkedIn profile`,
    icon: "mdi:linkedin",
  },
  {
    href: SOCIAL_LINKS.instagram,
    label: `Visit ${SITE_AUTHOR}'s Instagram profile`,
    icon: "mdi:instagram",
  },
  {
    href: SOCIAL_LINKS.mastodon,
    label: `Follow ${SITE_AUTHOR} on Mastodon`,
    icon: "mdi:mastodon",
  },
].filter(({ href }) => href.length > 0);
---

<footer
  class="md:flex md:justify-between md:items-center md:align-center font-overpass-mono w-full md:h-full mt-12"
>
  <div class="text-[12px] text-center items-center flex justify-center">
    &copy; {today.getFullYear()}{" "}{SITE_AUTHOR}. All rights reserved.
  </div>
  {
    SHOW_SOCIAL_LINKS && (
      <div class="flex justify-center gap-3 m-2 sm:m-0">
        {socialItems.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer">
            <span class="sr-only">{social.label}</span>
            <Icon name={social.icon} class="h-[20px] w-[20px]" />
          </a>
        ))}
        <a
          id="rss-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          style="visibility: hidden; width: 0; height: 0;"
        >
          <span class="sr-only">Subscribe to RSS Feed</span>
          <Icon name="mdi:rss" class="h-[20px] w-[20px]" />
        </a>
      </div>
    )
  }
  <slot />
</footer>
<script src="../scripts/rss.ts"></script>
