---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "./BlogPost.astro";
import { sortByDate } from "./sortByDate";
import { formatReadingTime } from "../scripts/utils";
import { type RouteCollection } from "../config/collections";

interface Props {
  config: RouteCollection;
}

const { config } = Astro.props;
const posts = await getCollection(config.name);
const sorted = [...posts].sort(sortByDate);
const isPhotography = config.name === "journeys";

const resolved = config.readingTime
  ? await Promise.all(
      sorted.map(async (post) => {
        const { remarkPluginFrontmatter } = await render(post);
        return {
          post,
          readingTimeMs: remarkPluginFrontmatter.readingTimeMs as number,
        };
      }),
    )
  : sorted.map((post) => ({
      post,
      readingTimeMs: undefined as number | undefined,
    }));
---

<BaseLayout
  title={isPhotography ? "Photography · Juniverse" : config.title}
  description={isPhotography
    ? "Juniverse — photography journeys by Jun Bai."
    : undefined}
  is404Page={false}
>
  {isPhotography && <h1 class="sr-only">Photography</h1>}
  {
    resolved.map(({ post, readingTimeMs }) => (
      <BlogPost
        url={`/${config.name}/${post.id}/`}
        image={post.data?.image?.src || ""}
        alt={post.data?.image?.alt || ""}
        title={post.data?.title || ""}
        description={post.data?.description || ""}
        pubDate={post.data?.pubDate || ""}
        positionx={post.data?.image?.positionx || ""}
        positiony={post.data?.image?.positiony || ""}
        isJourney={isPhotography}
        ongoing={post.data?.ongoing ?? false}
        minutesRead={
          readingTimeMs != null ? formatReadingTime(readingTimeMs) : undefined
        }
      />
    ))
  }
</BaseLayout>
